				voltage-min-design-microvolt = <3450000>;
				ocv-capacity-celsius = <20>;
				ocv-capacity-table-0 = <4376000 100>, <4324000 95>, <4269000 90>,
							<4211000 85>, <4154000 80>, <4100000 75>,
							<4049000 70>, <4003000 65>, <3950000 60>,
							<3897000 55>, <3865000 50>, <3839000 45>,
							<3817000 40>, <3800000 35>, <3780000 30>,
							<3752000 25>, <3731000 20>, <3706000 15>,
							<3681000 10>, <3668000 5>, <3400000 0>;
				voltage-temp-table = <1307738 700>, <1203814 750>, <1095466 800>,
							<986111 850>, <878558 900>, <775112 950>,
							<678460 1000>, <590240 1050>, <510772 1100>,
							<440156 1150>, <378279 1200>, <324561 1250>,
